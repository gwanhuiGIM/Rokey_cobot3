            token outputs:mdl:volume.connect = </root/Looks/ABS_Soft_Leather_Deep_Mint_02/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @https://omniverse-content-production.s3.us-west-2.amazonaws.com/Materials/2023_1/vMaterials_2/Leather/ABS_Soft_Leather.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "ABS_Soft_Leather_Deep_Mint"
                token outputs:out (
